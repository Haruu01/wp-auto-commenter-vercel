    "var_79042eb4f23c": {
      "type": "variant",
      "label": "Cyber Terminal",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<div class=\"h-screen w-full bg-[#010B13] text-[#d0d0cc] font-['Fira_Sans'] flex flex-col overflow-hidden selection:bg-[#E3FF00] selection:text-black\" data-kid=\"1\" data-name=\"page layout container\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Fira+Sans:wght@300;400;500;600&family=Fira+Code:wght@400;500&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    :root {\n      --neon-chartreuse: #E3FF00;\n      --cyan-glow: #00CCFF;\n      --ink-black: #010B13;\n      --onyx-black: #111111;\n      --hairline-color: rgba(255, 255, 255, 0.1);\n    }\n\n    .font-heading { font-family: 'Space Grotesk', sans-serif; }\n    .font-mono { font-family: 'Fira Code', monospace; }\n\n    .grid-bg {\n      background-image: radial-gradient(circle, rgba(227, 255, 0, 0.05) 1px, transparent 1px);\n      background-size: 30px 30px;\n    }\n\n    .glass-panel {\n      background: rgba(17, 17, 17, 0.95);\n      border: 1px solid var(--hairline-color);\n    }\n\n    .terminal-scrollbar::-webkit-scrollbar {\n      width: 4px;\n    }\n    .terminal-scrollbar::-webkit-scrollbar-track {\n      background: transparent;\n    }\n    .terminal-scrollbar::-webkit-scrollbar-thumb {\n      background: rgba(255, 255, 255, 0.1);\n    }\n    .terminal-scrollbar::-webkit-scrollbar-thumb:hover {\n      background: var(--neon-chartreuse);\n    }\n\n    .cursor-blink {\n      display: inline-block;\n      width: 8px;\n      height: 14px;\n      background: var(--neon-chartreuse);\n      animation: blink 1s step-end infinite;\n      vertical-align: middle;\n      margin-left: 4px;\n    }\n\n    @keyframes blink {\n      0%, 100% { opacity: 1; }\n      50% { opacity: 0; }\n    }\n\n    .brutalist-border {\n      border: 2px solid var(--neon-chartreuse);\n      box-shadow: 4px 4px 0px 0px var(--neon-chartreuse);\n    }\n    .brutalist-border:active {\n      transform: translate(2px, 2px);\n      box-shadow: 2px 2px 0px 0px var(--neon-chartreuse);\n    }\n\n    .hairline-b { border-bottom: 1px solid var(--hairline-color); }\n    .hairline-r { border-right: 1px solid var(--hairline-color); }\n    .hairline-l { border-left: 1px solid var(--hairline-color); }\n\n    /* Removed text shadows for cleaner TUI look as per review */\n\n    /* Custom line numbers textarea simulation */\n    .line-numbers {\n      counter-reset: line;\n    }\n    .line-numbers span::before {\n      counter-increment: line;\n      content: counter(line, decimal-leading-zero);\n      display: block;\n      color: rgba(255, 255, 255, 0.2);\n      font-size: 10px;\n      margin-bottom: 6px;\n    }\n    </style>\n    <!-- TOP BAR -->\n    <header class=\"h-16 hairline-b flex items-center justify-between px-6 z-10 shrink-0 bg-[#010B13] relative overflow-hidden\" data-kid=\"1-1\" data-name=\"header navigation bar\">\n        <!-- SCANLINE EFFECT -->\n        <div class=\"absolute inset-0 pointer-events-none opacity-[0.03] bg-[linear-gradient(rgba(255,255,255,0.1)_50%,transparent_50%)] bg-[length:100%_4px]\" data-kid=\"1-1-1\" data-name=\"header scanline effect overlay\">\n        </div>\n        <div class=\"flex items-center gap-8\" data-kid=\"1-1-2\" data-name=\"logo and system status container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-1\" data-name=\"app logo and title container\">\n                <div class=\"w-8 h-8 bg-[var(--neon-chartreuse)] flex items-center justify-center rotate-45 shadow-[0_0_15px_rgba(227,255,0,0.3)]\" data-kid=\"1-1-2-1-1\" data-name=\"terminal icon container\">\n                    <i class=\"ti ti-terminal text-black font-bold -rotate-45 text-lg\" data-kid=\"1-1-2-1-1-1\" data-name=\"terminal icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-2-1-2\" data-name=\"application brand text group\">\n                    <span class=\"font-heading font-black tracking-tighter text-2xl uppercase leading-none block\" data-kid=\"1-1-2-1-2-1\" data-name=\"application title\">\n                        CyberTerminal\n                    </span>\n                    <span class=\"text-white/30 text-[11px] font-mono tracking-[0.3em] block mt-1 uppercase\" data-kid=\"1-1-2-1-2-2\" data-name=\"application subtitle\">\n                        WP_AUTO_COMMENTER // SYS.LOG.01\n                    </span>\n                </div>\n            </div>\n            <div class=\"hidden lg:flex items-center gap-6 text-xs text-white/40 font-mono\" data-kid=\"1-1-2-2\" data-name=\"system status info container\">\n                <div class=\"flex flex-col\" data-kid=\"1-1-2-2-1\" data-name=\"system status group\">\n                    <span class=\"text-[var(--cyan-glow)] opacity-50\" data-kid=\"1-1-2-2-1-1\" data-name=\"system status label\">\n                        SYSTEM_STATUS\n                    </span>\n                    <span class=\"flex items-center gap-1.5 text-white/80\" data-kid=\"1-1-2-2-1-2\" data-name=\"system status value text\">\n                        <span class=\"w-1.5 h-1.5 bg-[var(--neon-chartreuse)] rounded-full animate-pulse\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"status pulse indicator\">\n                        </span>\n                        READY_FOR_EXEC\n                    </span>\n                </div>\n                <div class=\"flex flex-col\" data-kid=\"1-1-2-2-2\" data-name=\"active node group\">\n                    <span class=\"text-[var(--cyan-glow)] opacity-50\" data-kid=\"1-1-2-2-2-1\" data-name=\"active node label\">\n                        ACTIVE_NODE\n                    </span>\n                    <span class=\"text-white/80\" data-kid=\"1-1-2-2-2-2\" data-name=\"active node value\">\n                        VAR_79042EB4\n                    </span>\n                </div>\n                <div class=\"flex flex-col\" data-kid=\"1-1-2-2-3\" data-name=\"security level group\">\n                    <span class=\"text-[var(--cyan-glow)] opacity-50\" data-kid=\"1-1-2-2-3-1\" data-name=\"security level label\">\n                        SEC_LEVEL\n                    </span>\n                    <span class=\"text-[var(--neon-chartreuse)]\" data-kid=\"1-1-2-2-3-2\" data-name=\"security level value\">\n                        MAXIMUM\n                    </span>\n                </div>\n            </div>\n        </div>\n        <div class=\"flex items-center gap-6\" data-kid=\"1-1-3\" data-name=\"navigation actions container\">\n            <div class=\"flex gap-2 text-[10px] font-mono\" data-kid=\"1-1-3-1\" data-name=\"navigation button group\">\n                <button class=\"px-3 py-1.5 border border-white/10 hover:bg-white/5 transition-colors uppercase\" data-kid=\"1-1-3-1-1\" data-name=\"documentation button\">\n                    Documentation\n                </button>\n                <button class=\"px-3 py-1.5 border border-[var(--neon-chartreuse)] text-[var(--neon-chartreuse)] bg-[var(--neon-chartreuse)]/5 hover:bg-[var(--neon-chartreuse)] hover:text-black transition-colors uppercase\" data-kid=\"1-1-3-1-2\" data-name=\"deploy button\">\n                    Deploy\n                </button>\n            </div>\n            <div class=\"w-10 h-10 border border-white/10 p-0.5 rotate-3\" data-kid=\"1-1-3-2\" data-name=\"user avatar container\">\n                <img alt=\"Avatar\" class=\"w-full h-full grayscale opacity-80 object-cover\" data-kid=\"1-1-3-2-1\" data-name=\"user avatar image\" src=\"https://i.pravatar.cc/40?u=dev_admin\"/>\n            </div>\n        </div>\n    </header>\n    <!-- MAIN APP CONTAINER -->\n    <main class=\"flex-1 flex overflow-hidden grid-bg\" data-kid=\"1-2\" data-name=\"main content grid container\">\n        <!-- COLUMN 1: AI SETTINGS (LEFT) -->\n        <aside class=\"w-[300px] bg-[#111111] hairline-r flex flex-col shrink-0 overflow-y-auto terminal-scrollbar p-6 space-y-8\" data-kid=\"1-2-1\" data-name=\"ai settings sidebar\">\n            <!-- IDENTITY SECTION -->\n            <section class=\"space-y-6\" data-kid=\"1-2-1-1\" data-name=\"identity settings section\">\n                <div class=\"flex items-center gap-2 mb-3\" data-kid=\"1-2-1-1-1\" data-name=\"identity header container\">\n                    <div class=\"w-1 h-3 bg-[var(--cyan-glow)]\" data-kid=\"1-2-1-1-1-1\" data-name=\"identity section accent bar\">\n                    </div>\n                    <h3 class=\"text-xs font-heading font-bold uppercase tracking-widest text-[var(--cyan-glow)]\" data-kid=\"1-2-1-1-1-2\" data-name=\"identity section title\">\n                        Identity\n                    </h3>\n                </div>\n                <div class=\"space-y-5\" data-kid=\"1-2-1-1-2\" data-name=\"identity input field group\">\n                    <div class=\"space-y-2\" data-kid=\"1-2-1-1-2-1\" data-name=\"author name field group\">\n                        <label class=\"text-[11px] uppercase text-white/40 tracking-widest block font-bold\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"author name label\">\n                            Author Name\n                        </label>\n                        <input class=\"w-full bg-transparent border-b border-white/10 py-1.5 text-sm font-mono focus:border-[var(--neon-chartreuse)] outline-hidden transition-colors\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"author name input\" type=\"text\" value=\"System_Admin\"/>\n                    </div>\n                    <div class=\"space-y-2\" data-kid=\"1-2-1-1-2-2\" data-name=\"website url field group\">\n                        <label class=\"text-[11px] uppercase text-white/40 tracking-widest block font-bold\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"website url label\">\n                            Website URL\n                        </label>\n                        <input class=\"w-full bg-transparent border-b border-white/10 py-1.5 text-sm font-mono focus:border-[var(--neon-chartreuse)] outline-hidden transition-colors\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"website url input\" type=\"text\" value=\"https://core-terminal.net\"/>\n                    </div>\n                </div>\n            </section>\n            <!-- AI CONFIG SECTION -->\n            <section class=\"space-y-8\" data-kid=\"1-2-1-2\" data-name=\"ai configuration section\">\n                <div class=\"flex items-center gap-2 mb-3\" data-kid=\"1-2-1-2-1\" data-name=\"ai config header container\">\n                    <div class=\"w-1 h-3 bg-[var(--cyan-glow)]\" data-kid=\"1-2-1-2-1-1\" data-name=\"ai config section accent bar\">\n                    </div>\n                    <h3 class=\"text-xs font-heading font-bold uppercase tracking-widest text-[var(--cyan-glow)]\" data-kid=\"1-2-1-2-1-2\" data-name=\"ai config section title\">\n                        AI Configuration\n                    </h3>\n                </div>\n                <div class=\"space-y-4\" data-kid=\"1-2-1-2-2\" data-name=\"tone profile setting group\">\n                    <label class=\"text-[11px] uppercase text-white/40 tracking-widest font-bold\" data-kid=\"1-2-1-2-2-1\" data-name=\"tone profile label\">\n                        Tone Profile\n                    </label>\n                    <div class=\"flex flex-col gap-1.5\" data-kid=\"1-2-1-2-2-2\" data-name=\"tone profile options container\">\n                        <button class=\"group flex items-center justify-between p-4 border-l-2 border-[var(--neon-chartreuse)] bg-white/5 text-xs font-bold text-[var(--neon-chartreuse)] text-left hover:bg-white/10 transition-colors\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"tone profile professional option\">\n                            <span data-kid=\"1-2-1-2-2-2-1-1\" data-name=\"tone profile professional label\">\n                                01 :: PROFESSIONAL & ANALYTIC\n                            </span>\n                            <div class=\"w-2 h-2 bg-[var(--neon-chartreuse)]\" data-kid=