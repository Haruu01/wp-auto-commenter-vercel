    },
    "var_69ac4518505c": {
      "type": "variant",
      "label": "Ethereal Aurora",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<div class=\"main-wrapper min-h-screen bg-[#0B0B1A] font-['Inter'] text-white overflow-x-clip relative\" data-kid=\"1\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap');\n        @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n        :root {\n            --mauve: #DF73FF;\n            --aqua: #00CCFF;\n            --space: #0B0B1A;\n            --glass: rgba(28, 28, 66, 0.45);\n        }\n\n        .font-heading { font-family: 'Plus Jakarta Sans', sans-serif; }\n\n        .aurora-mesh {\n            position: fixed;\n            inset: -50%;\n            width: 200%;\n            height: 200%;\n            background: \n                radial-gradient(circle at 30% 20%, var(--mauve) 0%, transparent 30%),\n                radial-gradient(circle at 70% 80%, var(--aqua) 0%, transparent 30%),\n                radial-gradient(circle at 50% 50%, #1C1C42 0%, var(--space) 100%);\n            filter: blur(100px);\n            z-index: 0;\n            opacity: 0.5;\n            pointer-events: none;\n        }\n\n        .glass-panel {\n            background: linear-gradient(135deg, rgba(28, 28, 66, 0.6), rgba(28, 28, 66, 0.3));\n            backdrop-filter: blur(40px);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            box-shadow: 0 60px 120px -30px rgba(0, 0, 0, 0.8);\n        }\n\n        .glass-card {\n            background: rgba(255, 255, 255, 0.03);\n            backdrop-filter: blur(12px);\n            border: 1px solid rgba(255, 255, 255, 0.06);\n        }\n\n        .glass-highlight::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            height: 1px;\n            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);\n            z-index: 1;\n        }\n\n        .pill-active {\n            background: var(--mauve);\n            color: black;\n            box-shadow: 0 0 15px rgba(223, 115, 255, 0.4);\n        }\n\n        .input-glass {\n            background: rgba(0, 0, 0, 0.3);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            border-radius: 16px;\n            padding: 12px 16px;\n            color: white;\n            transition: all 0.3s;\n        }\n\n        .input-glass:focus {\n            border-color: var(--mauve);\n            outline: none;\n            background: rgba(0, 0, 0, 0.5);\n        }\n    </style>\n    <div class=\"aurora-mesh\" data-dynamic=\"true\" data-kid=\"1-1\" data-name=\"animated aurora gradient mesh background\" data-reason=\"background position animated continuously by gsap\">\n    </div>\n    <main class=\"relative z-10 min-h-screen flex flex-col items-center justify-start py-16 px-6 lg:px-12\" data-kid=\"1-2\" data-name=\"main application and content area\">\n        <!-- Header -->\n        <header class=\"text-center mb-16 max-w-3xl mx-auto\" data-kid=\"1-2-1\" data-name=\"header section\">\n            <div class=\"inline-flex items-center gap-4 mb-6 px-6 py-2 rounded-full glass-card border-white/10\" data-kid=\"1-2-1-1\" data-name=\"brand identity container\">\n                <span class=\"text-3xl\" data-kid=\"1-2-1-1-1\" data-name=\"robot emoji icon\">\n                    🤖\n                </span>\n                <div class=\"text-left border-l border-white/10 pl-4\" data-kid=\"1-2-1-1-2\" data-name=\"brand identity text group\">\n                    <h1 class=\"font-heading text-2xl font-extrabold tracking-tight bg-gradient-to-r from-white to-white/40 bg-clip-text text-transparent\" data-kid=\"1-2-1-1-2-1\" data-name=\"brand name headline\">\n                        CommentBot\n                    </h1>\n                    <p class=\"text-[10px] font-bold text-[var(--mauve)] uppercase tracking-[0.2em]\" data-kid=\"1-2-1-1-2-2\" data-name=\"brand version label\">\n                        AI Auto Comment v2.0\n                    </p>\n                </div>\n            </div>\n            <p class=\"text-white/40 text-lg leading-relaxed font-medium\" data-kid=\"1-2-1-2\" data-name=\"hero description text\">\n                Generate AI comments for WordPress articles naturally and instantly.\n            </p>\n        </header>\n        <!-- Main Island -->\n        <div class=\"glass-panel w-full max-w-6xl rounded-[40px] overflow-hidden flex flex-col shadow-2xl\" data-kid=\"1-2-2\" data-name=\"main application island container\">\n            <section class=\"p-10 lg:p-14 border-b border-white/5 bg-gradient-to-br from-white/[0.02] to-transparent\" data-kid=\"1-2-2-1\" data-name=\"configuration settings section\">\n                <div class=\"flex flex-col lg:flex-row gap-12\" data-kid=\"1-2-2-1-1\" data-name=\"wizard grid layout\">\n                    <!-- Left: Navigation & Progress -->\n                    <div class=\"lg:w-1/3 flex flex-col justify-between\" data-kid=\"1-2-2-1-1-1\" data-name=\"wizard navigation and progress\">\n                        <div data-kid=\"1-2-2-1-1-1-1\" data-name=\"setup instructions container\">\n                            <h2 class=\"font-heading text-3xl font-bold mb-2\" data-kid=\"1-2-2-1-1-1-1-1\" data-name=\"wizard title\">\n                                Setup\n                            </h2>\n                            <p class=\"text-white/30 text-sm mb-10\" data-kid=\"1-2-2-1-1-1-1-2\" data-name=\"wizard description text\">\n                                Configure your identity and target articles.\n                            </p>\n                            <div class=\"space-y-8\" data-kid=\"1-2-2-1-1-1-1-3\" data-name=\"steps list container\">\n                                <div class=\"flex items-center gap-5\" data-kid=\"1-2-2-1-1-1-1-3-1\" data-name=\"first step item\">\n                                    <div class=\"w-10 h-10 rounded-2xl bg-gradient-to-br from-[var(--mauve)] to-[var(--aqua)] p-0.5 flex items-center justify-center\" data-kid=\"1-2-2-1-1-1-1-3-1-1\" data-name=\"step circle indicator\">\n                                        <div class=\"w-full h-full rounded-[14px] bg-[#0B0B1A] flex items-center justify-center text-white font-bold text-sm\" data-kid=\"1-2-2-1-1-1-1-3-1-1-1\" data-name=\"step number one\">\n                                            1\n                                        </div>\n                                    </div>\n                                    <div data-kid=\"1-2-2-1-1-1-1-3-1-2\" data-name=\"first step info\">\n                                        <p class=\"text-xs font-bold text-white\" data-kid=\"1-2-2-1-1-1-1-3-1-2-1\" data-name=\"first step title\">\n                                            Identity & Targets\n                                        </p>\n                                        <p class=\"text-[9px] font-bold text-[var(--mauve)] uppercase tracking-wider\" data-kid=\"1-2-2-1-1-1-1-3-1-2-2\" data-name=\"first step status\">\n                                            Active\n                                        </p>\n                                    </div>\n                                </div>\n                                <div class=\"flex items-center gap-5 opacity-30\" data-kid=\"1-2-2-1-1-1-1-3-2\" data-name=\"second step item\">\n                                    <div class=\"w-10 h-10 rounded-2xl border border-white/20 flex items-center justify-center font-bold text-sm\" data-kid=\"1-2-2-1-1-1-1-3-2-1\" data-name=\"second step number\">\n                                        2\n                                    </div>\n                                    <div data-kid=\"1-2-2-1-1-1-1-3-2-2\" data-name=\"second step info\">\n                                        <p class=\"text-xs font-bold text-white\" data-kid=\"1-2-2-1-1-1-1-3-2-2-1\" data-name=\"second step title\">\n                                            Generation\n                                        </p>\n                                        <p class=\"text-[9px] font-bold uppercase tracking-wider\" data-kid=\"1-2-2-1-1-1-1-3-2-2-2\" data-name=\"second step status\">\n                                            Queue\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"mt-12 bg-white/[0.03] p-6 rounded-3xl border border-white/5\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"status indicator box\">\n                            <div class=\"flex justify-between items-end mb-3\" data-kid=\"1-2-2-1-1-1-2-1\" data-name=\"status header row\">\n                                <span class=\"text-[9px] font-bold text-white/40 uppercase tracking-widest\" data-kid=\"1-2-2-1-1-1-2-1-1\" data-name=\"status label text\">\n                                    Engine Status\n                                </span>\n                                <span class=\"text-xs font-bold text-[var(--aqua)]\" data-kid=\"1-2-2-1-1-1-2-1-2\" data-name=\"status value text\">\n                                    Ready\n                                </span>\n                            </div>\n                            <div class=\"h-1 w-full bg-white/10 rounded-full overflow-hidden\" data-kid=\"1-2-2-1-1-1-2-2\" data-name=\"progress bar track\">\n                                <div class=\"h-full w-0 bg-gradient-to-r from-[var(--mauve)] to-[var(--aqua)]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-1-2-2-1\" data-name=\"progress bar fill\" data-reason=\"width dynamically updated by script\" id=\"progress-bar\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <!-- Right: Form Fields -->\n                    <div class=\"lg:w-2/3 space-y-8\" data-kid=\"1-2-2-1-1-2\" data-name=\"form fields container\">\n                        <!-- Identity Inputs -->\n                        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"identity input group\">\n                            <div class=\"space-y-2\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"name field container\">\n                                <label class=\"text-[10px] font-bold text-white/40 uppercase tracking-widest ml-1\" data-kid=\"1-2-2-1-1-2-1-1-1\" data-name=\"name field label\">\n                                    Name\n                                </label>\n                                <input class=\"w-full input-glass text-sm\" data-kid=\"1-2-2-1-1-2-1-1-2\" data-name=\"name input field\" placeholder=\"Joenathan\" type=\"text\" value=\"Joenathan\"/>\n                            </div>\n                            <div class=\"space-y-2\" data-kid=\"1-2-2-1-1-2-1-2\" data-name=\"email field container\">\n                                <label class=\"text-[10px] font-bold text-white/40 uppercase tracking-widest ml-1\" data-kid=\"1-2-2-1-1-2-1-2-1\" data-name=\"email field label\">\n                                    Email\n                                </label>\n                                <input class=\"w-full input-glass text-sm\" data-kid=\"1-2-2-1-1-2-1-2-2\" data-name=\"email input field\" placeholder=\"email@example.com\" type=\"email\" value=\"berita@esaunggul.ac.id\"/>\n                            </div>\n                            <div class=\"md:col-span-2 space-y-2\" data-kid=\"1-2-2-1-1-2-1-3\" data-name=\"website field container\">\n                                <label class=\"text-[10px] font-bold text-white/40 uppercase tracking-widest ml-1\" data-kid=\"1-2-2-1-1-2-1-3-1\" data-name=\"website field label\">\n                                    Website\n                                </label>\n                                <input class=\"w-full input-glass text-sm\" data-kid=\"1-2-2-1-1-2-1-3-2\" data-name=\"website input field\" placeholder=\"https://www.esaunggul.ac.id/\" type=\"url\" value=\"https://www.esaunggul.ac.id/\"/>\n                            </div>\n                        </div>\n                        <!-- URL Textarea -->\n                        <div class=\"space-y-3\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"url textarea container\">\n                            <div class=\"flex justify-between items-center px-1\" data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"url header row\">\n                                <label class=\"text-[10px] font-bold text-white/40 uppercase tracking-widest\" data-kid=\"1-2-2-1-1-2-2-1-1\" data-name=\"url label\">\n                                    WordPress Article URLs\n                                </label>\n                                <span class=\"text-[9px] font-bold text-[var(--aqua)] bg-[var(--aqua)]/10 px-2 py-0.5 rounded-full\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2-2-1-2\" data-name=\"url count indicator\" data-reason=\"text updated as URLs are detected\">\n                                    0 URL Detected\n                                </span>\n                            </div>\n                            <textarea class=\"w-full input-glass min-h-[120px] resize-none font-mono text-sm leading-relaxed\" data-kid=\"1-2-2-1-1-2-2-2\" data-name=\"url text area\" placeholder=\"https://example.com/article-1\nhttps://example.com/article-2\"></textarea>\n                        </div>\n                        <!-- Settings & Actions -->\n                        <div class=\"flex flex-wrap items-center justify-between gap-6 pt-4\" data-kid=\"1-2-2-1-1-2-3\" data-name=\"settings and actions container\">\n                            <div class=\"flex gap-2\" data-kid=\"1-2-2-1-1-2-3-1\" data-name=\"tone selection buttons\">\n                                <button class=\"pill-active px-4 py-2 rounded-xl text-[10px] font-bold\" data-kid=\"1-2-2-1-1-2-3-1-1\" data-name=\"empathetic tone button\">\n                                    Empathetic\n                                </button>\n                                <button class=\"px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-white/40 text-[10px] font-bold hover:bg-white/10 transition-all\" data-kid=\"1-2-2-1-1-2-3-1-2\" data-name=\"skeptic tone button\">\n                                    Skeptic\n                                </button>\n                                <button class=\"px-4 py-2 rounded-xl bg-white/5 border border-white/10 text-white/40 text-[10px] font-bold hover:bg-white/10 transition-all\" data-kid=\"1-2-2-1-1-2-3-1-3\" data-name=\"curious tone button\">\n                                    Curious\n                                </button>\n                            </div>\n                            <div class=\"flex gap-3\" data-kid=\"1-2-2-1-1-2-3-2\" data-name=\"form action buttons\">\n                                <button class=\"px-6 py-3 rounded-2xl bg-white/5 border border-white/10 text-white/60 text-xs font-bold hover:bg-white/10 hover:text-white transition-all flex items-center gap-2\" data-kid=\"1-2-2-1-1-2-3-2-1\" data-name=\"clear button\">\n                                    <i class=\"ti ti-trash\" data-kid=\"1-2-2-1-1-2-3-2-1-1\" data-name=\"trash icon\">\n                                    </i>\n                                    Clear\n                                </button>\n                                <button class=\"px-8 py-3 rounded-2xl bg-gradient-to-r from-[var(--mauve)] to-[var(--aqua)] text-black font-extrabold text-sm hover:scale-105 transition-all shadow-lg shadow-[var(--mauve)]/20 flex items-center gap-2\" data-kid=\"1-2-2-1-1-2-3-2-2\" data-name=\"generate button\">\n                                    <i class=\"ti ti-sparkles\" data-kid=\"1-2-2-1-1-2-3-2-2-1\" data-name=\"sparkles icon\">\n                                    </i>\n                                    Generate Comments\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <!-- Results Section -->\n            <section class=\"p-10 lg:p-14 bg-black/20\" data-kid=\"1-2-2-2\" data-name=\"results section\">\n                <div class=\"flex items-center justify-between mb-8\" data-kid=\"1-2-2-2-1\" data-name=\"results header row\">\n                    <div data-kid=\"1-2-2-2-1-1\" data-name=\"results title group\">\n                        <h3 class=\"font-heading text-xl font-bold\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"results title\">\n                            Generation Results\n                        </h3>\n                        <p class=\"text-white/20 text-[10px] font-bold uppercase tracking-widest mt-1\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"status label\">\n                            Status: IDLE\n                        </p>\n                    </div>\n                    <div class=\"flex gap-2\" data-kid=\"1-2-2-2-1-2\" data-name=\"export buttons container\">\n                        <button class=\"px-4 py-2 rounded-xl glass-card text-[10px] font-bold text-[var(--aqua)] hover:border-[var(--aqua)] transition-all flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"export txt button\">\n                            <i class=\"ti ti-file-text\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"file text icon\">\n                            </i>\n                            Export TXT\n                        </button>\n                        <button class=\"px-4 py-2 rounded-xl glass-card text-[10px] font-bold text-[var(--aqua)] hover:border-[var(--aqua)] transition-all flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"export csv button\">\n                            <i class=\"ti ti-table\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"table icon\">\n                            </i>\n                            Export CSV\n                        </button>\n                    </div>\n                </div>\n                <!-- Masonry Feed -->\n                <div class=\"columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2\" data-name=\"masonry feed container\" data-reason=\"cards dynamically injected by script\">\n                    <!-- Result Card Template -->\n                    <div class=\"comment-card glass-card glass-highlight rounded-3xl p-6 break-inside-avoid border-l-2 border-l-[var(--mauve)]\" data-kid=\"1-2-2-2-2-1\" data-name=\"result comment card\">\n                        <div class=\"flex items-center justify-between mb-4\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"comment header\">\n                            <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"user info block\">\n                                <img alt=\"Avatar\" class=\"w-8 h-8 rounded-full border border-white/10\" data-kid=\"1-2-2-2-2-1-1-1-1\" data-name=\"user avatar\" src=\"https://i.pravatar.cc/32?u=alex\"/>\n                                <div data-kid=\"1-2-2-2-2-1-1-1-2\" data-name=\"user meta info\">\n                                    <p class=\"text-[10px] font-bold text-white\" data-kid=\"1-2-2-2-2-1-1-1-2-1\" data-name=\"user name\">\n                                        Alex Rivera\n                                    </p>\n                                    <p class=\"text-[8px] text-[var(--mauve)] font-bold uppercase\" data-kid=\"1-2-2-2-2-1-1-1-2-2\" data-name=\"comment status label\">\n                                        Success\n                                    </p>\n                                </div>\n                            </div>\n                            <button class=\"p-2 bg-white/5 hover:bg-white/10 rounded-lg text-white/40 transition-all\" data-kid=\"1-2-2-2-2-1-1-2\" data-name=\"copy button\">\n                                <i class=\"ti ti-copy text-xs\" data-kid=\"1-2-2-2-2-1-1-2-1\" data-name=\"copy icon\">\n                                </i>\n                            </button>\n                        </div>\n                        <a class=\"text-[9px] text-[var(--aqua)] hover:underline block mb-3 opacity-60\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"article link\" href=\"#\">\n                            🔗 esaunggul.ac.id/artikel-1\n                        </a>\n                        <p class=\"text-xs text-white/70 leading-relaxed font-medium\" data-kid=\"1-2-2-2-2-1-3\" data-name=\"comment text\">\n                            \"Analisis yang sangat menarik mengenai LCP dan optimalisasi performa web. Sangat membantu bagi pengembang!\"\n                        </p>\n                    </div>\n                </div>\n                <!-- Initial Empty State -->\n                <div class=\"flex flex-col items-center justify-center py-20 text-center opacity-20\" data-kid=\"1-2-2-2-3\" data-name=\"empty state container\">\n                    <i class=\"ti ti-message-2 text-5xl mb-4\" data-kid=\"1-2-2-2-3-1\" data-name=\"empty state icon\">\n                    </i>\n                    <p class=\"font-heading text-sm font-bold uppercase tracking-widest\" data-kid=\"1-2-2-2-3-2\" data-name=\"empty state message\">\n                        Enter URLs to start generating\n                    </p>\n                </div>\n            </section>\n        </div>\n        <footer class=\"mt-12 text-center text-white/20 text-[9px] font-bold uppercase tracking-[0.4em]\" data-kid=\"1-2-3\" data-name=\"footer info\">\n            CommentBot v2.0 • Enhanced Ethereal UI\n        </footer>\n    </main>\n    <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n    </script>\n    <script type=\"module\">\n        gsap.to(\".aurora-mesh\", {\n            backgroundPosition: \"100% 50%\",\n            duration: 25,\n            repeat: -1,\n            yoyo: true,\n            ease: \"sine.inOut\"\n        });\n    </script>\n</div>\n",
